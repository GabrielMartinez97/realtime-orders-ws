# ==============================================================================
# CONFIGURACIÓN DE EJEMPLO (.env.example)
# Copia este archivo a ".env" y ajusta los valores para tu entorno local.
# ==============================================================================

PROJECT_NAME="Sistema de Pedidos en Tiempo Real"
ENVIRONMENT="development"

# Base de datos:
# - Desarrollo inicial (SQLite): sqlite:///./realtime_orders.db
# - Producción (PostgreSQL): postgresql+psycopg://usuario:password@localhost:5432/realtime_orders
DATABASE_URL="sqlite:///./realtime_orders.db"

# Seguridad JWT (Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY="CAMBIA_ESTA_CLAVE_EN_PRODUCCION_POR_UNA_CADENA_HEX_DE_64_CARACTERES"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Orígenes permitidos para CORS y validación de Origin en WebSockets (separados por coma)
ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# Límites de Rate Limiting (ventana de 60 segundos)
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_ORDERS_PER_MINUTE=10

# Inicializar datos semilla de demostración al arrancar
SEED_DEMO_DATA=true
